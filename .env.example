# Configuração local. Acesso autenticado é o padrão seguro.
APP_ENV=development
DEV_NO_AUTH=false
DATABASE_PATH=data/secco.sqlite3

# Preencher somente com valores reais autorizados, sem versionar este arquivo preenchido.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Confirmar o domínio Workspace com o responsável. Não deduzir pelo site.
GOOGLE_WORKSPACE_DOMAIN=
# Lista JSON de objetos com participant_id e email. E-mails reais ainda pendentes.
ALLOWED_USERS=[]
# Gerar localmente com secrets.token_urlsafe(48). Não reutilizar valor demonstrativo.
SESSION_SECRET=
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
SESSION_ROTATION_SECONDS=900

# Somente para manutenção local intencional sem identidade: DEV_NO_AUTH=true.
# Nunca habilitar em produção ou usar como teste de autorização.
